# Zonnestelsel on Apache (Strato). The folder settings of the main site (index page, no
# directory listings) still apply; this only adds to them.

# The fonts in fonts/ are already compressed (woff2); they only need the right type
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>

# Compress the text files (HTML, CSS, JavaScript, JSON), so pages load faster
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
  </IfModule>
</IfModule>
